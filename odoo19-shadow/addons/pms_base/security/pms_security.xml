<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="pms_device_rule_resident" model="ir.rule">
            <field name="name">PMS Device: Resident Isolation</field>
            <field name="model_id" ref="model_pms_device"/>
            <field name="groups" eval="[(4, ref('base.group_user')), (4, ref('portal.group_portal'))]"/>
            <field name="domain_force">[('resident_id', '=', user.id)]</field>
        </record>

        <record id="pms_telemetry_rule_resident" model="ir.rule">
            <field name="name">PMS Telemetry: Resident Isolation</field>
            <field name="model_id" ref="model_pms_telemetry"/>
            <field name="groups" eval="[(4, ref('base.group_user')), (4, ref('portal.group_portal'))]"/>
            <field name="domain_force">[('resident_id', '=', user.id)]</field>
        </record>

        <record id="pms_maintenance_rule_resident" model="ir.rule">
            <field name="name">PMS Maintenance: Resident Isolation</field>
            <field name="model_id" ref="model_pms_maintenance_request"/>
            <field name="groups" eval="[(4, ref('base.group_user')), (4, ref('portal.group_portal'))]"/>
            <field name="domain_force">[('resident_id', '=', user.id)]</field>
        </record>
    </data>
</odoo>
